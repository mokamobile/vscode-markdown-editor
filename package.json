{
  "name": "markdown-editor",
  "displayName": "%displayName%",
  "icon": "media/logo.png",
  "description": "%description%",
  "version": "0.2.1",
  "publisher": "zaaack",
  "private": true,
  "engines": {
    "vscode": "^1.47.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "typora",
    "markdown-previewer",
    "markdown-editor"
  ],
  "activationEvents": [
    "onCommand:markdown-editor.openEditor",
    "onWebviewPanel:markdown-editor",
    "onLanguage:markdown",
    "onCustomEditor:markdown-editor.editor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zaaack/vscode-markdown-editor.git"
  },
  "main": "out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-editor.openEditor",
        "title": "%command.openEditor%",
        "category": "%command.category%"
      },
      {
        "command": "markdown-editor.openInSplit",
        "title": "%command.openInSplit%",
        "category": "%command.category%",
        "icon": "$(pencil)"
        
      },
      {
        "command": "markdown-editor.toggleDefault",
        "title": "%command.toggleDefault%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "markdown-editor.openEditor",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "markdown-editor.openEditor",
          "group": "1_open"
        }
      ],
      "editor/title": [
        {
          "when": "resourceLangId == markdown && !activeWebviewPanelId",
          "command": "markdown-editor.openInSplit",
          "group": "navigation@2",
          "icon": "$(pencil)"
        }
      ]
    },
    "configuration": {
      "title": "markdown-editor",
      "properties": {
        "markdown-editor.isDefault": {
          "type": "boolean",
          "default": false,
          "description": "%config.isDefault%"
        },
        "markdown-editor.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "%config.showToolbar%"
        },
        "markdown-editor.imageSaveFolder": {
          "type": "string",
          "default": "assets",
          "description": "%config.imageSaveFolder%"
        },
        "markdown-editor.useVscodeThemeColor": {
          "type": "boolean",
          "default": true,
          "description": "%config.useVscodeThemeColor%"
        },
        "markdown-editor.customCss": {
          "type": "string",
          "default": "",
          "description": "%config.customCss%"
        },
        "markdown-editor.externalCssFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.externalCssFiles%"
        },
        "markdown-editor.cssLoadOrder": {
          "type": "string",
          "enum": ["external-first", "custom-first"],
          "default": "external-first",
          "description": "%config.cssLoadOrder%"
        },
        "markdown-editor.showOutlineByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%config.showOutlineByDefault%"
        },
        "markdown-editor.outlinePosition": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "left",
          "description": "%config.outlinePosition%"
        },
        "markdown-editor.outlineWidth": {
          "type": "number",
          "default": 200,
          "minimum": 150,
          "maximum": 500,
          "description": "%config.outlineWidth%"
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+shift+alt+m",
        "command": "markdown-editor.openEditor",
        "mac": "cmd+shift+alt+m",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "customEditors": [
      {
        "viewType": "markdown-editor.editor",
        "displayName": "%displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default",
        "when": "config.markdown-editor.isDefault"
      },
      {
        "viewType": "markdown-editor.editor",
        "displayName": "%displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option",
        "when": "!config.markdown-editor.isDefault"
      }
    ]
  },
  "scripts": {
    "watch": "foy watch",
    "start": "foy watch",
    "build": "foy build",
    "package": "./scripts/build-and-package.sh",
    "publish": "./scripts/build-and-publish.sh",
    "publish:package-only": "./scripts/build-and-publish.sh --package-only",
    "publish:skip-version": "./scripts/build-and-publish.sh --skip-version",
    "pub": "foy build && npm version patch && git push origin master --tags && vsce package && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^12.12.0",
    "@types/vscode": "^1.47.0",
    "foy": "^0.2.5",
    "ts-node": "9.1.1",
    "typescript": "4.2.2",
    "@vscode/l10n": "^0.0.1"
  },
  "l10n": "./l10n",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
